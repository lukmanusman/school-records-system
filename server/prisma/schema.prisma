// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum ResultStatus {
  DRAFT
  APPROVED
}

enum AssessmentStatus {
  PRESENT
  ABSENT
}

enum EnrollmentType {
  FRESHER
  TRANSFER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student         Student?
  teacher         Teacher?
  approvedResults Result[] @relation("ResultApprover")
  publishedResults ResultPublication[] @relation("ResultPublisher")
}

model Student {
  id              Int      @id @default(autoincrement())
  admissionNumber String   @unique
  firstName       String
  surname         String
  otherName       String?
  gender          String
  dateOfBirth     DateTime
  classId         Int?
  userId          Int?     @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])
  results    Result[]
  enrollment Enrollment?
}

model Enrollment {
  id                Int            @id @default(autoincrement())
  studentId         Int            @unique
  academicSessionId Int
  entryTermId       Int
  entryClassId      Int
  enrollmentType    EnrollmentType
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  student         Student         @relation(fields: [studentId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  entryTerm       Term            @relation(fields: [entryTermId], references: [id])
  entryClass      Class           @relation(fields: [entryClassId], references: [id])
}

model Teacher {
  id        Int      @id @default(autoincrement())
  firstName String
  surname   String
  otherName String?
  email     String   @unique
  userId    Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?               @relation(fields: [userId], references: [id])
  assignments TeacherAssignment[]
  results     Result[]
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      Student[]
  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
  enrollments   Enrollment[]
  resultPublications ResultPublication[]
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
  results       Result[]
}

model ClassSubject {
  id        Int      @id @default(autoincrement())
  classId   Int
  subjectId Int
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
}

model TeacherAssignment {
  id        Int      @id @default(autoincrement())
  teacherId Int
  subjectId Int
  classId   Int
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([teacherId, subjectId, classId])
}

model AcademicSession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms       Term[]
  results     Result[]
  enrollments Enrollment[]
  resultPublications ResultPublication[]
}

model Term {
  id                Int      @id @default(autoincrement())
  name              String
  academicSessionId Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  results         Result[]
  enrollments     Enrollment[]
  resultPublications ResultPublication[]

  @@unique([academicSessionId, name])
}

model Result {
  id                Int          @id @default(autoincrement())
  studentId         Int
  subjectId         Int
  teacherId         Int
  academicSessionId Int
  termId            Int
  caScore           Float?
  caStatus          AssessmentStatus @default(PRESENT)
  examScore         Float?
  examStatus        AssessmentStatus @default(PRESENT)
  status            ResultStatus @default(DRAFT)
  approvedAt        DateTime?
  approvedById      Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  student         Student         @relation(fields: [studentId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  teacher         Teacher         @relation(fields: [teacherId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            Term            @relation(fields: [termId], references: [id])
  approvedBy      User?           @relation("ResultApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, academicSessionId, termId])
}

model AdmissionNumberCounter {
  id             Int            @id @default(autoincrement())
  year           Int
  enrollmentType EnrollmentType
  nextNumber     Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([year, enrollmentType])
}

model ResultPublication {
  id                Int       @id @default(autoincrement())
  classId           Int
  academicSessionId Int
  termId            Int
  publishedAt       DateTime?
  publishedById     Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  class           Class           @relation(fields: [classId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            Term            @relation(fields: [termId], references: [id])
  publishedBy     User?           @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([classId, academicSessionId, termId])
}